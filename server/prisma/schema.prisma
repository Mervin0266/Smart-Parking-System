generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model student {
  register_number Int     @id
  name            String? @db.VarChar(100)
  email           String? @db.VarChar(100)
  phone           String? @db.VarChar(20)
  department      String? @db.VarChar(100)
  license_number  String? @db.VarChar(30)
}

model faculty {
  faculty_id     Int     @id
  name           String? @db.VarChar(100)
  email          String? @db.VarChar(100)
  phone          String? @db.VarChar(20)
  department     String? @db.VarChar(100)
  license_number String? @db.VarChar(30)
}

model parking_log {
  log_id       Int           @id @default(autoincrement())
  vehicle_id   Int?
  slot_id      Int?
  entry_time   DateTime?     @default(now()) @db.Timestamp(6)
  exit_time    DateTime?     @db.Timestamp(6)
  notes        String?
  parking_slot parking_slot? @relation(fields: [slot_id], references: [slot_id], onDelete: NoAction, onUpdate: NoAction)
  vehicle      vehicle?      @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model parking_payment {
  payment_id Int       @id @default(autoincrement())
  vehicle_id Int?      @unique
  amount     Decimal?  @db.Decimal(10, 2)
  start_date DateTime? @db.Date
  end_date   DateTime? @db.Date
  status     String    @db.VarChar(20)
  vehicle    vehicle?  @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model parking_slot {
  slot_id         Int              @id @default(autoincrement())
  slot_name       String           @unique @db.VarChar(20)
  slot_type       String           @db.VarChar(20)
  is_occupied     Boolean?         @default(false)
  parking_log     parking_log[]
  slot_assignment slot_assignment?
}

model slot_assignment {
  assignment_id Int           @id @default(autoincrement())
  vehicle_id    Int?          @unique
  slot_id       Int?          @unique
  parking_slot  parking_slot? @relation(fields: [slot_id], references: [slot_id], onDelete: Cascade, onUpdate: NoAction)
  vehicle       vehicle?      @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id        Int     @id @default(autoincrement())
  username       String  @unique @db.VarChar(50)
  password_hash  String
  role           String  @db.VarChar(20)
  license_number String? @db.VarChar(30)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vehicle {
  vehicle_id      Int              @id @default(autoincrement())
  number_plate    String           @unique @db.VarChar(20)
  vehicle_type    String           @db.VarChar(10)
  owner_type      String           @db.VarChar(10)
  owner_id        Int?
  parking_log     parking_log[]
  parking_payment parking_payment?
  slot_assignment slot_assignment?
}

model visitor {
  name           String    @db.VarChar(100)
  phone          String    @db.VarChar(20)
  purpose        String?
  vehicle_number String    @unique @db.VarChar(20)
  id_proof       String?   @db.VarChar(100)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
}
